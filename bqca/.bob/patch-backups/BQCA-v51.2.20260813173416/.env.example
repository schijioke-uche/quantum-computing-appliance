# @Author: Dr. Jeffrey Chijioke-Uche, IBM Computer Scientist

#############################################################################
#         A  U  T  H  E  N  T  I  C  A  T  I  O  N
#############################################################################

# Bob Instance ID:
#
# Supported appliance classifications:
#   bob-001      = Pro Plus
#   IBM Internal = IBM Internal version
#   Trial        = Free Trial
#   Pro          = Pro Edition
#   Ultra        = Ultra Edition
BOB_INSTANCE_ID="IBM Internal"

# Bob API key: (Inference Type of API Key is Required)
BOB_API_KEY=""

# Pipe API Key: (Do not Change)
BOBSHELL_API_KEY="${BOB_API_KEY}"

# Pro Plus example:
# BOB_INSTANCE_ID="bob-001"
# BOB_API_KEY="REPLACE_WITH_PRO_PLUS_BOB_API_KEY"

# Bob API endpoint:
BOB_ENDPOINT="https://api.us-east.bob.ibm.com"

# Optional Bob authentication endpoint:
BOB_AUTH_ENDPOINT="https://console-ibm-prod.verify.ibm.com"

# Optional Bob region:
BOB_REGION="us-east"

#===============================================================================
# Bob Shell 2.x — BQCA Runtime Defaults
#===============================================================================

# Non-interactive output format: pretty | json | stream-json
BQCA_BOB2_OUTPUT_FORMAT=pretty

# Maximum number of agentic turns per request
BQCA_BOB2_MAX_TURNS=50

# Bob Shell logging: error | warn | info | debug | trace
BQCA_BOB2_LOG_LEVEL=warn

# Interactive tool auto-approval:
# 0 = require approval prompts
# 1 = automatically approve tool requests
BQCA_BOB2_AUTO_APPROVE=0

# Optional named Bob Shell interactive instance.
BQCA_BOB2_INSTANCE_ID="${BOB_INSTANCE_ID}"

# BQCA-BOB-SHELL-V2-DNA-ENV-v51.0:BEGIN
# Keep the concise BQCA context envelope enabled for Bob Shell 2.x non-interactive runs.
BQCA_BOB2_DNA_ENVELOPE=1
# Workspace lifecycle hooks are configured in .bob/settings.json and run only in a trusted workspace.
BQCA_BOB2_DNA_HOOKS=1
# BQCA-BOB-SHELL-V2-DNA-ENV-v51.0:END

# Optional Bob Shell 2.x mode overrides.
# Leave empty to allow BQCA to resolve its project custom modes dynamically.
BQCA_BOB2_INTERACTIVE_MODE=
BQCA_BOB2_ASK_MODE=
BQCA_BOB2_CODE_MODE=
BQCA_BOB2_ADVANCED_MODE=

# Required only when BOB_API_KEY is a General-scope API key.
# Leave empty when using the recommended Inference-scope API key.
# Set to "default" or to unique "your team id" when General API Key is created.
BOB_TEAM_ID=

#############################################################################
#         B  O  B   I  N  C  L  U  D  E  D   D  I  R  E  C  T  O  R  I  E  S
#############################################################################

# python-dotenv cannot execute:
#
#   SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
#
# Therefore, directory paths are represented as portable project-relative
# configuration values. The application should resolve them relative to the
# appliance root or the directory containing this .env file.

APPLIANCE_ROOT="."
QCA_DESIGN_DIR="${APPLIANCE_ROOT}/bob-quantum-designs"
QCA_STORE_DIR="${APPLIANCE_ROOT}/bob-quantum-store"

# Comma-separated list consumed by IBM Bob:
BOB_INCLUDED_DIRECTORY="${QCA_STORE_DIR},${QCA_DESIGN_DIR}"

# Appliance name:
APPLIANCE_NAME="IBM Bob Quantum Computing Agent (BQCA)"



#############################################################################
#         A  P  P  L  I  A  N  C  E   *   O  B  J  E  C  T  S
#############################################################################

# General-purpose IBM Quantum Platform API token:
# Replace this value with a newly rotated token.
IQP_API_TOKEN=""



#############################################################################
#         I  B  M   Q  U  A  N  T  U  M   C  H  A  N  N  E  L  S
#############################################################################

# Standard IBM Quantum Platform accounts:
#
# Current qiskit-ibm-runtime releases use ibm_quantum_platform.
# The former ibm_quantum channel is no longer supported.
# ibm_cloud is retained for compatibility in some releases but is discouraged
# for new IBM Quantum Platform configuration.
OPEN_PLAN_CHANNEL="ibm_quantum_platform"
PAID_PLAN_CHANNEL="ibm_quantum_platform"

# A TechZone or connector-specific environment may expose a custom channel.
# Use that value only when the installed Qiskit Connector explicitly supports
# and documents it.
#
# Example only:
# OPEN_PLAN_CHANNEL="xxxxxxxx"



#############################################################################
#         I  B  M   Q  U  A  N  T  U  M   A  P  I   A  C  C  E  S  S
#############################################################################

IQP_API_URL="https://auth.quantum-computing.ibm.com/api/users/loginWithToken"
IQP_RUNTIME_BACKEND_URL="https://api.quantum-computing.ibm.com/runtime/backends"



#############################################################################
#         I  B  M   Q  U  A  N  T  U  M   U  R  L  S
#############################################################################

CLOUD_API_URL="https://cloud.ibm.com"
QUANTUM_API_URL="https://auth.quantum.ibm.com/api"

# Historical defaults:
#   ibm_cloud   -> https://cloud.ibm.com
#   ibm_quantum -> https://auth.quantum.ibm.com/api
#
# Do not use ibm_quantum as the channel in current qiskit-ibm-runtime releases of v2.5.x.



#############################################################################
#         I  B  M   Q  U  A  N  T  U  M   I  N  S  T  A  N  C  E  S
#############################################################################

# IBM Quantum Platform service-instance CRN:
OPEN_PLAN_INSTANCE=""

# Paid service-instance CRN or connector-supported instance identifier:
PAID_PLAN_INSTANCE="REPLACE_WITH_PAID_PLAN_INSTANCE" # Contact IBM Support



#############################################################################
#         P  L  A  N   N  A  M  E  S
#############################################################################

# Default free/open plan:
OPEN_PLAN_NAME="open"

# Optional paid plans:
PAYGO_PLAN_NAME="pay-as-you-go"
FLEX_PLAN_NAME="flex"
PREMIUM_PLAN_NAME="premium"
DEDICATED_PLAN_NAME="dedicated"



#############################################################################
#         A  C  T  I  V  E   P  L  A  N
#############################################################################

# Switch exactly one plan to "on".
#
# The Open plan is enabled by default.
# Sign up at: https://quantum.cloud.ibm.com

OPEN_PLAN="on"
FLEX_PLAN="off"
PAYGO_PLAN="off"
PREMIUM_PLAN="off"
DEDICATED_PLAN="off"