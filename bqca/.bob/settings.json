{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh .bob/hooks/bqca-session-context.sh",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 .bob/hooks/bqca-user-prompt-context.py",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
